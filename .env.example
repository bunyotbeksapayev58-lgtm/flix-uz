# Telegram Bot Token (@BotFather dan olinadi)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Asosiy Super Admin Telegram ID (@userinfobot orqali bilish mumkin)
SUPER_ADMIN_ID=123456789

# Majburiy a'zolik kanallari (vergul bilan, ixtiyoriy, agar kerak bo'lmasa bo'sh qoldiring)
CHANNELS_TO_CHECK=

# Admin/Yordamchi aloqa usernami
SUPPORT_USERNAME=@admin_username

# Ma'lumotlar bazasi saqlash yo'li (Persistent Disk uchun, masalan Render/Pella da: /data/cinema.db)
# Agar bo'sh qoldirilsa, standart database/cinema.db ishlatiladi
DATABASE_PATH=

# Telegram Avtomatik Zaxiralash Kanali (Server o'chib yonganda yoki yangi deploy qilinganda kinolar o'chib ketmasligi uchun)
# Maxsus yopiq kanal ochib, botni unga ADMIN qiling va kanal ID raqamini (masalan: -1001234567890) yozing:
BACKUP_CHANNEL_ID=
AUTO_BACKUP_ENABLED=true

# Mini App Web manzili (HTTPS bo'lishi shart, masalan https://sizning-saytingiz.pella.app)
WEBAPP_URL=http://localhost:8080

# Premium tarif narxlari
PREMIUM_PRICE_1MONTH=15 000 so'm
PREMIUM_PRICE_3MONTHS=40 000 so'm
PREMIUM_PRICE_1YEAR=120 000 so'm
